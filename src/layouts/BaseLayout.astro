---
import { ClientRouter } from "astro:transitions";
import "katex/dist/katex.min.css";
import "../styles/global.css";
import Header from "../components/base/Header.astro";
import Footer from "../components/base/Footer.astro";
import Icon from "../components/base/Icon.astro";
import SearchModal from "../components/base/SearchModal.astro";
import { SITE } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** per-page OG image path (defaults to /og-default.png) */
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const site = Astro.site ?? new URL(SITE.domain);
const pageTitle = title ? `${title} · ${SITE.titleSuffix}` : SITE.titleSuffix;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image ?? "og-default.png", site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🪐</text></svg>"
    />
    <title>{pageTitle}</title>
    <ClientRouter />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.titleSuffix} href={new URL("rss.xml", site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- set theme before first paint to avoid FOUC -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("iko-theme");
        } catch {}
        const t =
          saved ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <!-- image lightbox: persists across client-side navigations -->
    <dialog id="lightbox" transition:persist="lightbox" aria-label="图片预览">
      <img id="lightboxImg" alt="" />
      <p id="lightboxCap"></p>
      <button id="lightboxClose" aria-label="关闭预览">✕</button>
    </dialog>
    <button id="backTop" title="回到顶部" aria-label="回到顶部">
      <Icon name="up" />
    </button>

    <script>
      // ---- persistent behaviors ------------------------------------------------
      // Bound once on document/window so they survive ClientRouter swaps; anything
      // bound to swapped elements lives in the astro:page-load handler below.
      const setTheme = (t: string) => {
        document.documentElement.dataset.theme = t;
        try {
          localStorage.setItem("iko-theme", t);
        } catch {}
      };
      const toggleTheme = () =>
        setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");

      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement | null;
        if (!t?.closest) return;
        if (t.closest("#themeBtn")) {
          toggleTheme();
          return;
        }
        if (t.closest("#menuBtn")) {
          document.getElementById("mobileMenu")?.classList.toggle("open");
          return;
        }
        if (t.closest("#mobileMenu a")) {
          document.getElementById("mobileMenu")?.classList.remove("open");
          return;
        }
        if (t.closest("#backTop")) {
          scrollTo({ top: 0, behavior: "smooth" });
          return;
        }
        // lightbox: clicking an article image opens the shared <dialog>
        const img = t.closest("img");
        if (img?.closest(".prose")) {
          const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
          const big = document.getElementById("lightboxImg") as HTMLImageElement | null;
          if (dlg && big) {
            e.preventDefault();
            big.src = img.currentSrc || img.src;
            big.alt = img.alt;
            const cap = document.getElementById("lightboxCap");
            if (cap) cap.textContent = img.alt;
            dlg.showModal();
          }
        }
      });

      // keyboard: T toggles theme (when not typing)
      document.addEventListener("keydown", (e) => {
        const ae = document.activeElement;
        const typing = !!ae && /^(INPUT|TEXTAREA)$/.test(ae.tagName);
        if ((e.key === "t" || e.key === "T") && !typing && !e.ctrlKey && !e.metaKey) toggleTheme();
      });

      // nav elevation + back-to-top + reading progress (elements re-queried per
      // tick so swapped pages keep working without rebinding)
      addEventListener(
        "scroll",
        () => {
          document.getElementById("nav")?.classList.toggle("scrolled", scrollY > 8);
          document.getElementById("backTop")?.classList.toggle("show", scrollY > 420);
          const bar = document.getElementById("readProgress");
          if (bar) {
            const h = document.documentElement;
            const max = h.scrollHeight - innerHeight;
            bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
          }
        },
        { passive: true },
      );

      // lightbox close (backdrop click / close button); dialog persists, so
      // binding once is enough. Esc is native to <dialog>.
      const lb = document.getElementById("lightbox") as HTMLDialogElement | null;
      lb?.addEventListener("click", (e) => {
        if (e.target === lb) lb.close();
      });
      document.getElementById("lightboxClose")?.addEventListener("click", () => lb?.close());

      // ---- per-page setup (runs on first load and after every client-side nav) --
      const onPageLoad = () => {
        // code block copy button (client-side enhancement over shiki output)
        document.querySelectorAll("pre.astro-code").forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-wrap")) return;
          const parent = pre.parentNode;
          if (!parent) return;
          const wrap = document.createElement("div");
          wrap.className = "code-wrap";
          parent.insertBefore(wrap, pre);
          wrap.appendChild(pre);
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "code-copy";
          btn.textContent = "复制";
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(pre.textContent ?? "");
              btn.textContent = "已复制";
            } catch {
              btn.textContent = "复制失败";
            }
            setTimeout(() => (btn.textContent = "复制"), 1600);
          });
          wrap.appendChild(btn);
        });

        // reveal on scroll
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("on");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.06 },
        );
        document.querySelectorAll(".reveal:not(.on)").forEach((el) => io.observe(el));
      };
      document.addEventListener("astro:page-load", onPageLoad);
    </script>
  </body>
</html>
