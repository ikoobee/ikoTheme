---
/**
 * Global search modal — Pagefind-powered, lazy island.
 * Opens via nav button or Ctrl/⌘+K. The pagefind index is generated by
 * `npm run build` (post-build step); in `astro dev` a hint is shown instead.
 */
import Icon from "./Icon.astro";
import { NAV } from "../../config/site";
---

<div class="modal-mask" id="searchMask" role="dialog" aria-modal="true" aria-label="站内搜索">
  <div class="search-modal">
    <div class="search-input-row">
      <span class="search-ic"><Icon name="search" /></span>
      <input id="searchInput" type="text" placeholder="全局搜索文章 / 项目 / 动态 / 页面…" autocomplete="off" aria-label="站内搜索" />
      <kbd>ESC</kbd>
    </div>
    <div class="search-results" id="searchResults"></div>
    <div class="sr-footer">
      <span><kbd>↑↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>esc</kbd> 关闭</span>
      <span style="margin-left:auto" id="srCount"></span>
    </div>
  </div>
</div>

<script
  is:inline
  type="application/json"
  id="quickNav"
  set:html={JSON.stringify([{ url: "/", title: "首页" }, ...NAV.map((n) => ({ url: n.href, title: n.label }))])}
/>

<script>
  const mask = document.getElementById("searchMask");
  const input = document.getElementById("searchInput") as HTMLInputElement | null;
  const box = document.getElementById("searchResults");
  const countEl = document.getElementById("srCount");

  interface Item {
    url: string;
    title: string;
    excerpt?: string;
  }
  let items: Item[] = [];
  let sel = -1;
  // pf: undefined = not loaded yet, null = unavailable (dev), object = loaded
  let pf: any;

  async function ensurePf(): Promise<any> {
    if (pf !== undefined) return pf;
    try {
      const url = "/pagefind/pagefind.js";
      pf = await import(/* @vite-ignore */ url);
      await pf.options?.({ baseUrl: "/" });
    } catch {
      pf = null;
    }
    return pf;
  }

  function escHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] ?? c,
    );
  }

  function renderPages() {
    let quick: { url: string; title: string }[] = [];
    try {
      quick = JSON.parse(document.getElementById("quickNav")?.textContent ?? "[]");
    } catch {}
    items = quick;
    sel = 0;
    if (box)
      box.innerHTML = items
        .map(
          (x, i) =>
            `<a class="sr-item${i === 0 ? " sel" : ""}" href="${x.url}" data-i="${i}">
              <div class="sr-body"><div class="sr-title">${escHtml(x.title)}</div>
              <div class="sr-sub">${x.url}</div></div>
              <span class="badge">页面</span></a>`,
        )
        .join("");
    if (countEl) countEl.textContent = "";
  }

  async function search(qRaw: string) {
    const q = qRaw.trim();
    if (!q) {
      renderPages();
      return;
    }
    const pagefind = await ensurePf();
    if (!pagefind) {
      items = [];
      sel = -1;
      if (box)
        box.innerHTML =
          '<div class="sr-empty">搜索索引未生成（dev 模式属正常）<br><span style="font-size:12px">运行 <code>npm run build</code> 后 <code>npm run preview</code> 体验全文搜索</span></div>';
      if (countEl) countEl.textContent = "";
      return;
    }
    const res = await pagefind.search(q);
    const raw = await Promise.all((res.results ?? []).slice(0, 8).map((r: any) => r.data()));
    items = raw.map((d: any) => ({
      url: d.url as string,
      title: (d.meta?.title as string) ?? d.url,
      excerpt: d.excerpt as string | undefined,
    }));
    sel = items.length ? 0 : -1;
    if (box)
      box.innerHTML = items.length
        ? items
            .map(
              (x, i) =>
                `<a class="sr-item${i === 0 ? " sel" : ""}" href="${x.url}" data-i="${i}">
                  <div class="sr-body"><div class="sr-title">${escHtml(x.title)}</div>
                  <div class="sr-sub">${x.excerpt ?? escHtml(x.url)}</div></div></a>`,
            )
            .join("")
        : `<div class="sr-empty">没有找到与「${escHtml(q)}」相关的内容</div>`;
    if (countEl) countEl.textContent = items.length ? `${items.length} 个结果` : "";
  }

  function moveSel(d: number) {
    if (!items.length) return;
    sel = (sel + d + items.length) % items.length;
    box?.querySelectorAll(".sr-item").forEach((el, i) => el.classList.toggle("sel", i === sel));
    box?.querySelector(".sr-item.sel")?.scrollIntoView({ block: "nearest" });
  }

  function open() {
    mask?.classList.add("open");
    if (input) input.value = "";
    renderPages();
    setTimeout(() => input?.focus(), 30);
  }
  function close() {
    mask?.classList.remove("open");
  }

  document.getElementById("searchBtn")?.addEventListener("click", open);
  mask?.addEventListener("click", (e) => {
    if (e.target === mask) close();
  });
  input?.addEventListener("input", (e) => void search((e.target as HTMLInputElement).value));
  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      moveSel(1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      moveSel(-1);
    } else if (e.key === "Enter") {
      e.preventDefault();
      const it = items[sel < 0 ? 0 : sel];
      if (it) {
        close();
        location.href = it.url;
      }
    }
  });
  document.addEventListener("keydown", (e) => {
    const ae = document.activeElement;
    const typing = !!ae && /^(INPUT|TEXTAREA)$/.test(ae.tagName);
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      mask?.classList.contains("open") ? close() : open();
    } else if (e.key === "Escape" && mask?.classList.contains("open")) {
      close();
    } else if (e.key === "/" && !typing) {
      e.preventDefault();
      open();
    }
  });
</script>
