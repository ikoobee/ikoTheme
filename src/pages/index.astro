---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/base/Icon.astro";
import PostCard from "../components/cards/PostCard.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import ProfileCard from "../components/cards/ProfileCard.astro";
import AnnounceCard from "../components/cards/AnnounceCard.astro";
import TaxonomyCard from "../components/cards/TaxonomyCard.astro";
import FriendsCard from "../components/cards/FriendsCard.astro";
import { SITE, STATUS_LABEL, SIDEBAR } from "../config/site";
import {
  postsByDate,
  projectsAll,
  momentsAll,
  tagMap,
  readingTime,
  fmtDate,
  fmtDateTime,
  siteDays,
  coverVisual,
} from "../utils/content";

const posts = await postsByDate();
const projects = await projectsAll();
const moments = (await momentsAll()).slice(0, 3);

const pinned = posts.find((p) => p.data.pinned) ?? posts[0];
const latest = posts.filter((p) => p !== pinned).slice(0, 4);
const featProjects = projects.filter((p) => p.data.featured);
const moreProjects = projects.filter((p) => !p.data.featured).slice(0, 2);

const tm = tagMap(posts);
const days = siteDays();
const pinnedCover = pinned ? coverVisual(pinned.id) : null;
---

<BaseLayout>
  <header class="hero">
    <div class="hero-media" aria-hidden="true">
      <svg viewBox="0 0 1440 460" preserveAspectRatio="xMidYMax slice">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0b0a1e"></stop>
            <stop offset=".28" stop-color="#241c58"></stop>
            <stop offset=".55" stop-color="#5b3a8f"></stop>
            <stop offset=".8" stop-color="#b4476b"></stop>
            <stop offset="1" stop-color="#f59e0b"></stop>
          </linearGradient>
          <linearGradient id="aur1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#34d399" stop-opacity="0"></stop>
            <stop offset=".45" stop-color="#34d399" stop-opacity=".5"></stop>
            <stop offset=".75" stop-color="#22d3ee" stop-opacity=".28"></stop>
            <stop offset="1" stop-color="#22d3ee" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="aur2" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#a78bfa" stop-opacity="0"></stop>
            <stop offset=".5" stop-color="#f0abfc" stop-opacity=".34"></stop>
            <stop offset="1" stop-color="#a78bfa" stop-opacity="0"></stop>
          </linearGradient>
          <radialGradient id="sunG">
            <stop offset="0" stop-color="#fff7ed"></stop>
            <stop offset=".55" stop-color="#fbbf24"></stop>
            <stop offset="1" stop-color="#f59e0b" stop-opacity=".85"></stop>
          </radialGradient>
          <radialGradient id="haloG">
            <stop offset="0" stop-color="#fbbf24" stop-opacity=".4"></stop>
            <stop offset="1" stop-color="#fbbf24" stop-opacity="0"></stop>
          </radialGradient>
          <linearGradient id="reflG" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fbbf24" stop-opacity=".6"></stop>
            <stop offset="1" stop-color="#f59e0b" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="waterlineG" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#f59e0b" stop-opacity="0"></stop>
            <stop offset=".24" stop-color="#f59e0b" stop-opacity=".38"></stop>
            <stop offset=".55" stop-color="#f59e0b" stop-opacity=".1"></stop>
            <stop offset="1" stop-color="#f59e0b" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="shootG" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity=".95"></stop>
          </linearGradient>
          <filter id="b36" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="30"></feGaussianBlur></filter>
          <filter id="b10" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter>
        </defs>

        <rect width="1440" height="460" fill="url(#sky)"></rect>

        <!-- star field -->
        <g fill="#fff">
          <circle cx="120" cy="52" r="1.4" opacity=".85" class="tw t1"></circle>
          <circle cx="205" cy="118" r="1" opacity=".6"></circle>
          <circle cx="300" cy="40" r="1.6" opacity=".9" class="tw t2"></circle>
          <circle cx="405" cy="96" r="1" opacity=".55"></circle>
          <circle cx="492" cy="58" r="1.2" opacity=".75"></circle>
          <circle cx="580" cy="120" r="1" opacity=".5" class="tw t3"></circle>
          <circle cx="668" cy="46" r="1.5" opacity=".85"></circle>
          <circle cx="760" cy="92" r="1" opacity=".6"></circle>
          <circle cx="848" cy="36" r="1.3" opacity=".8" class="tw t1"></circle>
          <circle cx="935" cy="104" r="1" opacity=".55"></circle>
          <circle cx="1030" cy="50" r="1.4" opacity=".85"></circle>
          <circle cx="1120" cy="96" r="1.1" opacity=".7" class="tw t2"></circle>
          <circle cx="1262" cy="52" r="1.3" opacity=".8"></circle>
          <circle cx="1380" cy="110" r="1.1" opacity=".65" class="tw t3"></circle>
          <circle cx="60" cy="150" r="1.2" opacity=".7"></circle>
          <circle cx="700" cy="160" r="1" opacity=".5"></circle>
          <circle cx="1300" cy="170" r="1" opacity=".55"></circle>
          <!-- sparkle crosses on the two brightest -->
          <g class="tw t1" stroke="#fff" stroke-width=".7" opacity=".8">
            <path d="M300 32 v16 M292 40 h16"></path>
          </g>
          <g class="tw t2" stroke="#fff" stroke-width=".7" opacity=".7">
            <path d="M848 26 v20 M838 36 h20"></path>
          </g>
        </g>

        <!-- shooting star -->
        <g class="shoot">
          <rect x="240" y="86" width="150" height="2" rx="1" fill="url(#shootG)" transform="rotate(-14 240 86)"></rect>
          <circle cx="388" cy="49" r="2.2" fill="#fff"></circle>
        </g>

        <!-- aurora ribbons -->
        <path class="aur a1" d="M-80 130 C 260 30, 520 190, 800 110 S 1240 30, 1520 130 L1520 20 L-80 20 Z" fill="url(#aur1)" filter="url(#b36)"></path>
        <path class="aur a2" d="M-80 190 C 320 90, 640 250, 980 160 S 1300 90, 1520 180 L1520 90 L-80 90 Z" fill="url(#aur2)" filter="url(#b36)"></path>

        <!-- ringed planet (🪐 motif) -->
        <g class="planet">
          <circle cx="1168" cy="118" r="30" fill="#c4b5fd" opacity=".92"></circle>
          <circle cx="1160" cy="110" r="9" fill="#ddd6fe" opacity=".5"></circle>
          <g transform="rotate(-16 1168 118)" fill="none" stroke="#e0e7ff" stroke-opacity=".75">
            <ellipse cx="1168" cy="118" rx="50" ry="12" stroke-width="1.4"></ellipse>
            <ellipse cx="1168" cy="118" rx="62" ry="15" stroke-width=".7" stroke-opacity=".4"></ellipse>
          </g>
        </g>

        <!-- setting sun + halo -->
        <circle cx="360" cy="332" r="80" fill="url(#haloG)"></circle>
        <circle cx="360" cy="332" r="24" fill="url(#sunG)"></circle>

        <!-- mountain layers -->
        <path d="M0 300 L180 190 L340 280 L520 170 L700 290 L860 210 L1040 300 L1200 200 L1440 310 L1440 460 L0 460 Z" fill="#3b3262" opacity=".68"></path>
        <path d="M0 340 L220 240 L420 330 L640 230 L840 330 L1020 260 L1240 350 L1440 280 L1440 460 L0 460 Z" fill="#2a2450" opacity=".85"></path>
        <path d="M0 400 L260 300 L500 390 L760 300 L1000 400 L1260 320 L1440 390 L1440 460 L0 460 Z" fill="#141031"></path>

        <!-- water band + sun reflection (line brightness falls off from the source) -->
        <rect x="0" y="428" width="1440" height="32" fill="#0c0a20"></rect>
        <rect x="0" y="426" width="1440" height="2" fill="url(#waterlineG)"></rect>
        <g filter="url(#b10)">
          <rect class="refl" x="340" y="424" width="40" height="38" fill="url(#reflG)"></rect>
          <rect class="refl r2" x="326" y="432" width="68" height="5" rx="2.5" fill="#fbbf24" opacity=".3"></rect>
          <rect class="refl r3" x="310" y="443" width="100" height="4" rx="2" fill="#fbbf24" opacity=".18"></rect>
        </g>
      </svg>
    </div>
    <canvas class="hero-canvas" id="heroCanvas" aria-hidden="true"></canvas>
    <div class="hero-veil"></div>
    <div class="hero-inner">
      <div class="hero-avatar">E</div>
      <h1 class="hero-name"><small>{SITE.name}</small>{SITE.author.name}</h1>
      <p class="hero-typed">
        <span id="typed" data-lines={JSON.stringify(SITE.taglines)}></span><span class="cursor"></span>
      </p>
      <div class="hero-badges">
        {SITE.heroBadges.map((b) => <span>{b}</span>)}
      </div>
    </div>
  </header>

  <div class="home-layout container">
    <!-- left: prioritized main stream -->
    <div class="home-main">
      <section>
        <div class="section-title">
          <Icon name="zap" /> 精选
          <small><a href="/posts/">全部文章 →</a></small>
        </div>
        {
          pinned && (
            <article class="card clickable feat-post reveal">
              <a
                class="fc"
                style={`background:${pinnedCover!.g}`}
                data-glyph={pinnedCover!.glyph}
                href={`/posts/${pinned.id}/`}
                aria-label={pinned.data.title}
              >
                {pinnedCover!.glyph}
                {pinned.data.pinned && <span class="ribbon">置顶</span>}
              </a>
              <div class="fb">
                <div class="meta-line">
                  <span class={`cat cat-${pinned.data.category}`}>{pinned.data.category}</span>
                  <span>{fmtDate(pinned.data.date)}</span>
                  <span>
                    <Icon name="clock" /> {readingTime(pinned)} min
                  </span>
                </div>
                <h3><a href={`/posts/${pinned.id}/`} title={pinned.data.title}>{pinned.data.title}</a></h3>
                <p class="f-desc">{pinned.data.desc}</p>
                <div class="tags-line">
                  {pinned.data.tags.map((t) => <span># {t}</span>)}
                </div>
                <a class="readmore" href={`/posts/${pinned.id}/`}>阅读全文 →</a>
              </div>
            </article>
          )
        }
        <div class="home-2col" style="margin-top:20px">
          {
            featProjects.map((pr) => {
              const logo = coverVisual(pr.data.name);
              return (
                <article class="card clickable proj-hl reveal">
                  <div class="logo" style={`background:${logo.g}`}>{logo.glyph}</div>
                  <div style="min-width:0">
                    <h3>
                      <span class="pname" title={pr.data.name}>{pr.data.name}</span>
                      <span class={`badge st-${pr.data.status}`}>
                        {STATUS_LABEL[pr.data.status]}
                      </span>
                    </h3>
                    <p>{pr.data.desc}</p>
                    <div class="mini-stats">
                      {
                        pr.data.repo && (
                          <a href={pr.data.repo} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:4px">
                            <Icon name="github" /> 仓库
                          </a>
                        )
                      }
                      <span>
                        <Icon name="zap" /> {pr.data.license}
                      </span>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section>
        <div class="section-title">
          <Icon name="pen" /> 最新文章
          <small><a href="/posts/">查看全部 →</a></small>
        </div>
        <div class="home-2col">
          {latest.map((p) => <PostCard post={p} />)}
        </div>
      </section>

      <section>
        <div class="section-title">
          <Icon name="rocket" /> 开源项目
          <small><a href="/projects/">全部项目 →</a></small>
        </div>
        <div class="home-2col">
          {moreProjects.map((pr) => <ProjectCard project={pr} />)}
        </div>
      </section>

      <section>
        <div class="section-title">
          <Icon name="chat" /> 最新动态
          <small><a href="/moments/">全部动态 →</a></small>
        </div>
        <div class="card reveal">
          {moments.map((m) => (
            <div class="moment-item">
              <time datetime={m.data.date.toISOString()}>{fmtDateTime(m.data.date)}</time>
              {m.data.text}
            </div>
          ))}
          <a class="card-more" href="/moments/">过去的事，都在动态里 →</a>
        </div>
      </section>
    </div>

    <!-- right: companion sidebar, driven by SIDEBAR in site.ts -->
    <aside class="home-side">
      {
        SIDEBAR.map((b) =>
          b === "profile" ? (
            <ProfileCard posts={posts.length} projects={projects.length} tags={tm.size} days={days} />
          ) : b === "announce" ? (
            <AnnounceCard />
          ) : b === "taxonomy" ? (
            <TaxonomyCard />
          ) : b === "friends" ? (
            <FriendsCard />
          ) : null,
        )
      }
    </aside>
  </div>
</BaseLayout>

<script>
  // hero scripts re-init after each client-side navigation (astro:page-load
  // also fires on first load); loops self-terminate once their element is
  // detached from the document
  document.addEventListener("astro:page-load", () => {
    // typing taglines
    const el = document.getElementById("typed");
    if (el) {
      const lines: string[] = JSON.parse(el.dataset.lines ?? "[]");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || lines.length === 0) {
        el.textContent = lines[0] ?? "";
      } else {
        let li = 0,
          ci = 0,
          del = false;
        const step = () => {
          if (!el.isConnected) return; // page navigated away
          const line = lines[li] ?? "";
          ci += del ? -1 : 1;
          el.textContent = line.slice(0, ci);
          let wait = del ? 36 : 90;
          if (!del && ci === line.length) {
            del = true;
            wait = 2100;
          } else if (del && ci === 0) {
            del = false;
            li = (li + 1) % lines.length;
            wait = 400;
          }
          setTimeout(step, wait);
        };
        step();
      }
    }

    // hero constellation network (nodes drift, nearby nodes link up;
    // reduced-motion users skip)
    const canvas = document.getElementById("heroCanvas") as HTMLCanvasElement | null;
    if (canvas && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const ctx = canvas.getContext("2d");
      if (ctx) {
        let W = 0,
          H = 0;
        const nodes: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
        const size = () => {
          W = canvas.width = canvas.offsetWidth;
          H = canvas.height = canvas.offsetHeight;
        };
        size();
        const N = Math.max(40, Math.min(84, Math.round(W / 15)));
        for (let i = 0; i < N; i++) {
          nodes.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() * 2 - 1) * 0.28,
            vy: (Math.random() * 2 - 1) * 0.28,
            r: 0.8 + Math.random() * 1.6,
          });
        }
        const LINK = 120;
        const tick = () => {
          if (!canvas.isConnected) return; // page navigated away
          if (canvas.offsetWidth !== W) size();
          ctx.clearRect(0, 0, W, H);
          for (const n of nodes) {
            n.x += n.vx;
            n.y += n.vy;
            if (n.x < -6) n.x = W + 6;
            else if (n.x > W + 6) n.x = -6;
            if (n.y < -6) n.y = H + 6;
            else if (n.y > H + 6) n.y = -6;
          }
          // links
          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const a = nodes[i]!,
                b = nodes[j]!;
              const dx = a.x - b.x,
                dy = a.y - b.y;
              const d2 = dx * dx + dy * dy;
              if (d2 < LINK * LINK) {
                const o = 1 - Math.sqrt(d2) / LINK;
                ctx.strokeStyle = `rgba(226, 232, 255, ${o * 0.35})`;
                ctx.lineWidth = 0.7;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
              }
            }
          }
          // nodes
          for (const n of nodes) {
            ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, 6.3);
            ctx.fill();
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }
  });
</script>
