---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/base/Icon.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";
import { STATUS_LABEL } from "../../config/site";
import { projectsAll, coverVisual } from "../../utils/content";

const projects = await projectsAll();
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<BaseLayout title="项目" description={`开源项目集 · 共 ${projects.length} 个`}>
  <div class="view-pad container">
    <div class="page-head">
      <h1>项目集 <span class="grad-text">Projects</span></h1>
      <p>造过的轮子，踩过的坑，都在这里留档</p>
    </div>

    <div class="filter-bar">
      <button class="chip on" data-proj-filter="all">
        全部 · {projects.length}
      </button>
      {
        Object.keys(STATUS_LABEL).map((s) => {
          const n = projects.filter((p) => p.data.status === s).length;
          return n > 0 ? (
            <button class={`chip st-${s}`} data-proj-filter={s}>
              {STATUS_LABEL[s]} · {n}
            </button>
          ) : null;
        })
      }
    </div>
    <div class="empty-hint" id="projEmpty" style="display:none">该状态下暂无项目</div>

    {
      featured.length > 0 && (
        <div class="proj-featured">
          {featured.map((pr) => {
            const logo = coverVisual(pr.data.name);
            return (
              <article class="card proj-fcard reveal" data-status={pr.data.status}>
                <div class="top">
                  <div class="logo" style={`background:${logo.g}`}>{logo.glyph}</div>
                  <div style="min-width:0">
                    <h3>
                      <span class="pname">{pr.data.name}</span>
                      <span class={`badge st-${pr.data.status}`}>
                        {STATUS_LABEL[pr.data.status]}
                      </span>
                    </h3>
                    <div class="mini-stats" style="margin-top:6px">
                      {pr.data.repo && (
                        <a href={pr.data.repo} target="_blank" rel="noopener">
                          <Icon name="github" /> 仓库
                        </a>
                      )}
                      {pr.data.demo && (
                        <a href={pr.data.demo} target="_blank" rel="noopener">
                          <Icon name="link" /> 在线体验
                        </a>
                      )}
                      <span><Icon name="zap" /> {pr.data.license}</span>
                    </div>
                  </div>
                </div>
                <p class="desc">{pr.data.desc}</p>
                <div class="foot">
                  <div class="tech-chips">
                    {pr.data.tech.map((t) => <span>{t}</span>)}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )
    }

    <div class="proj-grid">
      {rest.map((pr) => <ProjectCard project={pr} />)}
    </div>
  </div>
</BaseLayout>

<script>
  // client-side status filter (all cards are in the DOM, zero framework)
  const chips = document.querySelectorAll<HTMLElement>("[data-proj-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-status]");
  const empty = document.getElementById("projEmpty");
  const apply = (f: string) => {
    let shown = 0;
    cards.forEach((c) => {
      const ok = f === "all" || c.dataset.status === f;
      c.style.display = ok ? "" : "none";
      if (ok) shown++;
    });
    chips.forEach((c) => c.classList.toggle("on", (c.dataset.projFilter ?? "all") === f));
    if (empty) empty.style.display = shown ? "none" : "";
  };
  chips.forEach((c) =>
    c.addEventListener("click", () => apply(c.dataset.projFilter ?? "all")),
  );
</script>
