---
/**
 * giscus adapter — GitHub Discussions powered, zero backend.
 * Lazy-loads on scroll; theme syncs with the site's data-theme toggle.
 */
interface Props {
  repo: string;
  repoId: string;
  category: string;
  categoryId: string;
}
const { repo, repoId, category, categoryId } = Astro.props;
---

<div
  class="comments-box"
  id="giscus-mount"
  data-repo={repo}
  data-repo-id={repoId}
  data-category={category}
  data-category-id={categoryId}
>
  <div class="comments-loading">评论区加载中…</div>
</div>

<script>
  // lazy-load on scroll; re-inits after each client-side navigation
  document.addEventListener("astro:page-load", () => {
    const mount = document.getElementById("giscus-mount");
    if (!mount) return;
    const theme = () =>
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    const load = () => {
      if (mount.querySelector("iframe")) return;
      const s = document.createElement("script");
      s.src = "https://giscus.app/client.js";
      s.crossOrigin = "anonymous";
      s.async = true;
      s.dataset.repo = mount.dataset.repo ?? "";
      s.dataset.repoId = mount.dataset.repoId ?? "";
      s.dataset.category = mount.dataset.category ?? "";
      s.dataset.categoryId = mount.dataset.categoryId ?? "";
      s.dataset.mapping = "pathname";
      s.dataset.strict = "0";
      s.dataset.reactionsEnabled = "1";
      s.dataset.emitMetadata = "0";
      s.dataset.inputPosition = "top";
      s.dataset.theme = theme();
      s.dataset.lang = "zh-CN";
      mount.appendChild(s);
      mount.querySelector(".comments-loading")?.remove();
      // keep giscus iframe theme in sync with the site theme toggle;
      // self-disconnect once this page is swapped away
      const mo = new MutationObserver(() => {
        if (!mount.isConnected) {
          mo.disconnect();
          return;
        }
        const frame = mount.querySelector("iframe");
        frame?.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: theme() } } },
          "https://giscus.app",
        );
      });
      mo.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        load();
      }
    }).observe(mount);
  });
</script>
